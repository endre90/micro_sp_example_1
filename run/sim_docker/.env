# Configuration for the dockerized stack. docker compose reads this file
# automatically; every value here is the default the compose file would use
# anyway, so it is safe to edit or delete lines.

# --- ROS ----------------------------------------------------------------------
ROS_DISTRO=lyrical
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# --- Robot --------------------------------------------------------------------
ROBOT_ID=r1
ROBOT_MODEL=ur5
INITIAL_JOINT_STATE=0,-1.5708,1.5708,-1.5708,-1.5708,0
# See run/sim_native/.env: 30 is about 300 deg/s and 1 m/s; 6 is a real-robot pace.
ROBOT_SPEED=30.0

# --- The dice cell ------------------------------------------------------------
N_DICE=6
N_PADS=3
STALE_STEP_MS=1000
# Fix the start and every throw, for a repeatable demo. Empty = random.
CELL_SEED=
# An order placed as soon as the runner is up, e.g. red:6 green:5 blue:4.
INITIAL_ORDER=

# --- micro_sp -----------------------------------------------------------------
SP_INSTANCE_ID=sp1
RUST_LOG=info

# --- Upstream sources ---------------------------------------------------------
VIZ_GIT_REF=v0.4.0
SIM_GIT_REF=master
# Only its ur_description directory is used.
UR_REDIS_DRIVER_GIT_REF=v0.3.1
# A branch: rebuild to pick up a push (./run_in_docker.sh --rebuild-gui).
MICRO_SP_GUI_GIT_REF=master

# --- RViz rendering -----------------------------------------------------------
SCREEN_GEOMETRY=1600x900
SCREEN_DEPTH=24
# Empty lets Mesa choose (GPU when available); 1 forces software rendering.
LIBGL_ALWAYS_SOFTWARE=
# Auto-detected by run_in_docker.sh; set only to override.
# DRI_RENDER_NODE=/dev/dri/renderD128
# RENDER_GID=990

# --- Host ports ---------------------------------------------------------------
REDIS_HOST_PORT=6379
MICRO_SP_GUI_HOST_PORT=8080
RVIZ_HOST_PORT=6081
