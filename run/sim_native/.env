# Configuration for the native run.
#
# install_natively.sh and run_natively.sh both read this file (through
# native_env.sh), and `docker compose` in this directory reads it too, for the
# one container the native run still uses: Redis. Every value below is the
# default the scripts would use anyway, so it is safe to edit or delete lines.
#
# Paths may be absolute or start with ~; anything else is resolved against the
# repository root, not this directory, so the file works in a fresh clone.

# --- ROS ----------------------------------------------------------------------
# Only the visualization bridge and RViz use ROS; everything else talks Redis.
ROS_DISTRO=lyrical
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
#ROS_SETUP=/opt/ros/lyrical/setup.bash
#ROS_PACKAGES=ros-lyrical-desktop

# --- Sources built and run from disk ------------------------------------------
# install_natively.sh clones the upstream repositories into DEPS_DIR. Point a
# *_DIR at your own checkout to develop against it instead.
DEPS_DIR=native_deps
#VIZ_DIR=native_deps/r2r_redis_visualization
#SIM_DIR=native_deps/simple_robot_simulator
# A development checkout of the simulator, e.g. one with IK restarts:
#SIM_DIR=~/rust_ws/simple_robot_simulator
#MICRO_SP_GUI_DIR=native_deps/micro_sp_gui
# The UR5's URDF and meshes ship in ur_redis_driver's repository; only that
# directory is used, the driver itself is not built.
#UR_DRIVER_DIR=native_deps/ur_redis_driver
#UR_DESCRIPTION_DIR=native_deps/ur_redis_driver/src/ur_description
DICE_CELL_DIR=dice_cell

VIZ_GIT_URL=https://github.com/sequenceplanner/r2r_redis_visualization.git
VIZ_GIT_REF=v0.4.0
# Not tagged past its alpha yet, so this tracks master.
SIM_GIT_URL=https://github.com/sequenceplanner/simple_robot_simulator.git
SIM_GIT_REF=master
UR_REDIS_DRIVER_GIT_URL=https://github.com/sequenceplanner/ur_redis_driver.git
UR_REDIS_DRIVER_GIT_REF=v0.3.1
MICRO_SP_GUI_GIT_URL=https://github.com/endre90/micro_sp_gui.git
MICRO_SP_GUI_GIT_REF=master

# micro_sp and friends are declared with ssh://git@github.com URLs but are
# public; the scripts rewrite them to https for their own cargo invocations, so
# no GitHub SSH key is needed. false fetches over SSH with your own key.
GITHUB_HTTPS_REWRITE=true

# --- micro_sp GUI -------------------------------------------------------------
MICRO_SP_GUI_PORT=8080
MICRO_SP_GUI_FRAMES_DIR=shared_folder/scenario/exported

# --- Robot --------------------------------------------------------------------
ROBOT_ID=r1
ROBOT_MODEL=ur5
# Gripper pointing straight down, over the arena.
INITIAL_JOINT_STATE=0,-1.5708,1.5708,-1.5708,-1.5708,0
# How fast the arm moves (simple_robot_simulator's velocity): joint moves take
# the leading joint at 10 * this deg/s, straight-line moves the tool at
# 0.035 * this m/s, both easing in and out. 30 is about 300 deg/s and 1 m/s -
# faster than a real UR5; 6 is a calm, real-robot pace. Checked clean up to 45.
ROBOT_SPEED=30.0

# --- Redis --------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- The dice cell ------------------------------------------------------------
# How many dice (2-6; red, green, blue, yellow, purple, orange in that order)
# and how many buffer pads (1-3).
N_DICE=6
N_PADS=3
# How long a planned step may wait for its precondition before the plan counts
# as stale and the goal is replanned.
STALE_STEP_MS=1000
# Fix the dice's starting order and faces, and every throw, for a repeatable
# demo. Empty means a different cell every start.
CELL_SEED=
# An order to place as soon as the runner is up, e.g. red:6 green:5 blue:4.
# Empty means nothing moves until one is written into `order` from the GUI.
INITIAL_ORDER=

# --- micro_sp -----------------------------------------------------------------
SP_INSTANCE_ID=sp1
RUST_LOG=info
MICRO_SP_ACTIVITY_LOG=1
MICRO_SP_ACTIVITY_LOG_DIR=run/sim_native/logs/micro_sp_logs

# --- The scene ----------------------------------------------------------------
SCENARIO_DIR=shared_folder/scenario
MESHES_DIR=shared_folder/meshes

# --- RViz ---------------------------------------------------------------------
# The same config the dockerized run mounts into its RViz container.
RVIZ_CONFIG=run/sim_docker/rviz/default.rviz
